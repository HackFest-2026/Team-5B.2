# Copy to backend/.env and adjust. Every value has a safe default; nothing here is required for the demo.

# --- storage ---
# DATABASE_URL=sqlite:///./data/monetize360.db     (default: backend/data/monetize360.db)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_STARTUP=true

# --- LLM strategy generator: groq | gemini | grok | mock ---
# Without a key the clearly labelled mock generator is used automatically.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
XAI_API_KEY=
GROK_MODEL=grok-4
LLM_TIMEOUT_S=45
# Optional: let the LLM rephrase persona concerns (numbers never change): gemini | grok | none
PERSONA_TEXT_PROVIDER=none

# --- market research (web search) that grounds generated strategies: auto | serpapi | serper | none ---
# auto picks whichever key is set. SerpApi keys are 64 hex chars, Serper keys 40 chars.
SEARCH_PROVIDER=auto
SERPAPI_API_KEY=
SERPER_API_KEY=
MARKET_MAX_PRODUCTS=3
MARKET_CACHE_TTL_H=24

# --- price optimizer: auto | ml | simulated | http ---
# auto = ml_updated GBT model if its artifacts load, else the transparent simulator.
OPTIMIZER_PROVIDER=auto
OPTIMIZER_MODEL=gbt
# ML_ARTIFACTS_DIR=../ml_updated/artifacts          (default: <repo>/ml_updated/artifacts)
# Pin the model file hash (recommended outside a demo):
ML_ARTIFACT_SHA256=
# Only for OPTIMIZER_PROVIDER=http (a remote service implementing the OptimizerRequest/Response contract)
OPTIMIZER_URL=

# --- customer-agent shadow validation: sync | background | off (customer quotes; the Simulator is always sync) ---
VALIDATION_MODE=background
VALIDATION_POP_SIM=1000
VALIDATION_POP_QUOTE=250
VALIDATION_SEED=42
